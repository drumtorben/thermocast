{
  "name": "thermocast",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.14",
  "features": {
    "ghcr.io/jsburckhardt/devcontainer-features/uv:1": {}
  },
  "postCreateCommand": "uv sync",
  "forwardPorts": [8123],
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "ms-toolsai.jupyter"],
      "settings": { "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python" }
    }
  },
  "containerEnv": { "PYTHONPATH": "${containerWorkspaceFolder}", "UV_LINK_MODE": "copy" }
}
